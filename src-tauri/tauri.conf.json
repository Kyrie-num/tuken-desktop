{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuken",
  "version": "../package.json",
  "identifier": "site.tuken.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5280",
    "beforeDevCommand": "pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "兔啃",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOEIxOTg1MUVBRDIzMDkKUldRSkk2MGVoUm1MUXJuVHQ0bGpDOXd0UVNld2RnRTVZV1VqYVQrcXBjMHlua3dpTTRQdGpUeWIK",
      "endpoints": [
        "https://download.tuken.site/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
